APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Central Bale bot (create using @botfather in Bale)
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
# Generate a random 32+ character [A-Za-z0-9_-] secret.
BALE_WEBHOOK_SECRET=

# Shared Rubika bot, created with @BotFather inside Rubika
RUBIKA_BOT_TOKEN=
RUBIKA_BOT_USERNAME=
# Generate with: openssl rand -hex 32
RUBIKA_WEBHOOK_SECRET=

# Official EitaaYar App API (not an unofficial bot/session)
EITAA_APP_TOKEN=
# Official Eitaa app/mini-app link obtained in EitaaYar
EITAA_APP_URL=
# Local cap on accepted sends, not the provider's verified account balance.
EITAA_MESSAGE_BUDGET=50000

# Iran uses the HTTPS address of the isolated Germany gateway worker.
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_SECRET=
EMAIL_GATEWAY_ENABLED=false
EMAIL_USER_DAILY_LIMIT=50
EMAIL_PROJECT_DAILY_LIMIT=30

# Same OAuth client ID and redirect URI on both servers; secret only on Germany.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_REDIRECT_URI=
GMAIL_OAUTH_CLIENT_SECRET=

# Web Push + VAPID. Generate once with: php artisan webpush:vapid:generate
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# Optional Germany egress: enable on Iran only if native Push Services are unreachable.
WEBPUSH_USE_GATEWAY=false
WEBPUSH_GATEWAY_URL=
WEBPUSH_GATEWAY_SECRET=
# Set true ONLY on the Germany worker. Keep same VAPID keys on both nodes.
WEBPUSH_GATEWAY_ENABLED=false

# Central IPPanel Edge access key: https://edge.ippanel.com/v1
IPPANEL_API_KEY=
IPPANEL_FROM_NUMBER=
IPPANEL_PROJECT_DAILY_LIMIT=100
IPPANEL_USER_DAILY_LIMIT=300
IPPANEL_RECIPIENT_HOURLY_LIMIT=5
